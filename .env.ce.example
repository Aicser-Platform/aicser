# Aicser Community Edition (CE) Docker environment
#
# Browser/public URLs must use localhost, an IP, or a real domain. Do not use
# Docker service names such as server:8000 or chat2chart-server:8000 for
# NEXT_PUBLIC_* variables.

AISER_EDITION=community
AISER_EDITION_LICENSE_KEY=

NEXT_PUBLIC_API_URL=http://localhost:8000

POSTGRES_DB=aicser
POSTGRES_USER=aicser
POSTGRES_PASSWORD=aicser_password
POSTGRES_PORT=5432

SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-base64-64
JWT_SECRET=
JWT_ALGORITHM=HS256
COOKIE_SECURE=false
ENCRYPTION_KEY=

ENVIRONMENT=production
REDIS_URL=redis://redis:6379
MAX_FILE_SIZE_MB=300
STORAGE_BACKEND=postgresql


SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=Aicser

DEV_CLIENT_PORT=3000
DEV_SERVER_PORT=8000
DEV_POSTGRES_PORT=5432
DEV_REDIS_PORT=6379
DEV_DEBUG_PORT=5678
NODE_MAX_OLD_SPACE_SIZE=4096
CLIENT_DEV_MEM_LIMIT=6g
NEXT_DEV_TURBO=false
WATCHPACK_POLLING=false
CHOKIDAR_USEPOLLING=false
ALLOW_UNVERIFIED_JWT_IN_DEV=true

NEXT_BUILD_CPUS=1
NEXT_BUILD_MAX_OLD_SPACE_SIZE=3072
