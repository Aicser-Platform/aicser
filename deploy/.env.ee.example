# Copy the settings you need into deploy/.env.ee (git-ignored) — docker-compose.ee.yml loads it for server + worker.
# ═══════════════════════════════════════════════════════════════════════════════
# Aicser Enterprise Edition (EE) — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
# Quick Start:
#   cp deploy/.env.ee.example deploy/.env
#   # Edit the values below, then run:
#   make -C deploy ee
#
# IMPORTANT: Browser/public URLs must use localhost, an IP, or a real domain.
#            Never use Docker service names (e.g. server:8000) for NEXT_PUBLIC_*
#            variables — those are only reachable inside the Docker network.
# ═══════════════════════════════════════════════════════════════════════════════


# ── Edition ──────────────────────────────────────────────────────────────────
AISER_EDITION=enterprise
# Your Enterprise license key (leave blank for community mode)
AISER_EDITION_LICENSE_KEY=


# ── Application ───────────────────────────────────────────────────────────────
# The public URL the browser uses to call the backend API
NEXT_PUBLIC_API_URL=http://localhost:8000
# The public URL users open in the browser. Backend emails use this for invite links.
# Production example: https://app.yourdomain.com
FRONTEND_URL=http://localhost:3000


# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
POSTGRES_DB=aiser_world_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432


# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
# Generate with: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-base64-64
JWT_ALGORITHM=HS256
# Set to true in production (requires HTTPS)
COOKIE_SECURE=false
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=


# ── Infrastructure ────────────────────────────────────────────────────────────
ENVIRONMENT=production
REDIS_URL=redis://redis:6379
MAX_FILE_SIZE_MB=300
STORAGE_BACKEND=postgresql


# ── AI: Embeddings (RAG / few-shot retrieval) ────────────────────────────────
# EMBEDDING_PROVIDER defaults to "local" (sentence-transformers, in-process,
# no key or network call needed) -- leave everything below blank to use it.
# Set EMBEDDING_PROVIDER to route through a hosted or self-hosted API instead:
#   azure         needs AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME (a deployment
#                 created specifically for an embedding model -- your chat
#                 deployment will NOT work here) + the AZURE_OPENAI_API_KEY/
#                 _ENDPOINT/_API_VERSION already set above, or the EMBEDDING_*
#                 vars below to override any of those independently.
#   openai        needs EMBEDDING_API_KEY or OPENAI_API_KEY.
#   google/gemini needs EMBEDDING_API_KEY, GEMINI_API_KEY, or GOOGLE_API_KEY.
#   openai_compat self-hosted embeddings endpoint (Ollama, vLLM, LM Studio, ...);
#                 needs EMBEDDING_API_BASE.
# EMBEDDING_PROVIDER=local
# EMBEDDING_LOCAL_MODEL=intfloat/multilingual-e5-small   # default; loaded at startup, cached in the hf_model_cache volume
# KNOWLEDGE_SEARCH_TIMEOUT_S=30   # Knowledge > Test search answers "starting up" instead of hanging
# EMBEDDING_MODEL=
# EMBEDDING_API_KEY=
# EMBEDDING_API_BASE=
# EMBEDDING_API_VERSION=
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
#
# EMBEDDING_DIMENSIONS: the knowledge-base vector column is a fixed
# vector(384) width. Any model whose native output isn't 384-wide needs this
# set to 384, or it silently loses the fast index (falls back to a slow full
# scan, no error) -- see embedding_service.py's module docstring. OpenAI's
# text-embedding-3-* and Matryoshka-trained models (e.g. Qwen3-Embedding)
# support this truncation natively. Example: a local Ollama serving
# Qwen3-Embedding-8B (native 4096-dim) --
#   EMBEDDING_PROVIDER=openai_compat
#   EMBEDDING_API_BASE=http://<ollama-host>:11434/v1
#   EMBEDDING_MODEL=qwen3-embedding-8b
#   EMBEDDING_DIMENSIONS=384
# EMBEDDING_DIMENSIONS=


# ── AI: Self-hosted / OpenAI-compatible chat models ──────────────────────────
# Off by default -- Aicser is a client here, it never starts a model server
# for you. Point these at Ollama, vLLM, LM Studio, or anything else that
# speaks the OpenAI-compatible API, and Aicser will register it as a model
# option alongside your cloud providers.
#
# From inside the server container, "localhost" means the container itself --
# use host.docker.internal for a model server running on this same host
# (docker-compose.ee.yml already maps that for you), or the model host's LAN
# IP for one running elsewhere.
#
# Try it without installing anything separately: this repo ships an optional,
# opt-in CPU-only Ollama service, off unless you ask for it:
#   docker compose -f docker-compose.ee.yml --profile ollama up -d
#   docker exec aiser-ollama-ee ollama pull qwen3:8b
# then set:
#   OLLAMA_BASE_URL=http://ollama:11434
#   OLLAMA_MODEL=qwen3:8b
#
# OLLAMA_BASE_URL=
# OLLAMA_MODEL=
# OPENAI_COMPAT_BASE_URL=
# OPENAI_COMPAT_MODEL=
# AISER_PRIVATE_MODELS=


# ── AI: PII (two toggles only) ───────────────────────────────────────────────
# 1) AISER_PII_DETECTION (default true)
#    Classify sensitive columns once per dataset (schema.pii_policy) and mask
#    those columns in LLM prompt copies only. Charts, result tables, and the
#    chat UI always keep real values — nothing to "unmask" after Analyze.
# 2) AISER_PII_GATE_ENABLED (default false)
#    Presidio/regex scrub of free-text LLM prompts/outputs. Opt in only if you
#    need egress redaction and accept occasional false positives on business text.
# Legacy alias for (1): AISER_PII_COLUMN_MASKING (used only if DETECTION is unset).
# AISER_PII_DETECTION=true
# AISER_PII_GATE_ENABLED=false


# ── AI: Primary / reasoning tier override (any OpenAI-compatible gateway) ───
# By default the fast/default chat tier uses AZURE_OPENAI_* above (falling
# back to OPENAI_API_KEY, then any self-hosted model above). Set
# PRIMARY_MODEL_PROVIDER to make a different provider the actual default
# WITHOUT deleting the Azure config -- Azure stays registered as a BYOK/
# fallback option, it's just no longer picked automatically. Same shape
# for REASONING_MODEL_* (the accuracy-critical tier -- NL2SQL, insight
# synthesis, error correction), which already existed before this section.
#
# Example: TokenHarbor (https://tokenharbor.ai) as a single OpenAI-compatible
# gateway in front of Qwen, DeepSeek, GLM, and others -- one API key, pay-as-
# you-go, no separate provider accounts:
#   PRIMARY_MODEL_PROVIDER=openai
#   PRIMARY_MODEL_ENDPOINT=https://tokenharbor.ai/v1
#   PRIMARY_MODEL_API_KEY=thk_...
#   PRIMARY_MODEL_DEPLOYMENT_NAME=<model id from tokenharbor.ai/models>
#   REASONING_MODEL_PROVIDER=openai
#   REASONING_MODEL_ENDPOINT=https://tokenharbor.ai/v1
#   REASONING_MODEL_API_KEY=thk_...
#   REASONING_MODEL_DEPLOYMENT_NAME=<a stronger model id for this tier>
# Confirm exact model ids/pricing on tokenharbor.ai/models before setting --
# they change as new model generations ship.
#
# PRIMARY_MODEL_PROVIDER=
# PRIMARY_MODEL_DEPLOYMENT_NAME=
# PRIMARY_MODEL_API_KEY=
# PRIMARY_MODEL_ENDPOINT=
# PRIMARY_MODEL_API_VERSION=
# REASONING_MODEL_PROVIDER=
# REASONING_MODEL_DEPLOYMENT_NAME=
# REASONING_MODEL_API_KEY=
# REASONING_MODEL_ENDPOINT=
# REASONING_MODEL_API_VERSION=


# ── AI: Curated OpenRouter models (Premium tier + extra Fast options) ───────
# One key adds several ready-made, pre-vetted model choices to the picker in
# one shot -- DeepSeek V4 Flash/Pro, GLM-5.3-Flash/GLM-5.3, MiMo-V2.5-Pro, and
# GPT-5.6 Luna -- without hand-writing a config block per model. Purely
# additive: never overrides PRIMARY_MODEL_*/REASONING_MODEL_* above, and a
# user/org can still BYOK any of these individually too.
#
# Get a key at https://openrouter.ai/settings/keys (pay-as-you-go, no
# separate accounts with each model vendor).
#
# To add a newly-released model later: edit
# _OPENROUTER_CURATED_MODELS in ee/modules/ai/services/litellm_service.py --
# one new dict entry, no other code changes needed. Verify the exact model id,
# pricing, and tool-calling support at https://openrouter.ai/<vendor>/<model>
# first; OpenRouter's catalog (and TokenHarbor's, if you're using that as
# PRIMARY/REASONING above) changes as new generations ship.
#
# OPENROUTER_API_KEY=
# OpenRouter resilience (only applies to openrouter/* models)
# OPENROUTER_FALLBACK_MODELS=google/gemini-3.5-flash,google/gemini-2.5-flash   # router switches server-side on errors; also the primary's backup model for hedging/timeouts
# LLM_HEDGE_AFTER_S_LOW_EFFORT=10   # race the backup when a low-effort call (narration) has shown no answer text after N s
# OPENROUTER_PROVIDER_SORT=latency     # latency | throughput | price
# OPENROUTER_DATA_COLLECTION=deny      # only hosts that do not retain/train on prompts
# OPENROUTER_ZDR=true                  # zero-data-retention hosts only
# OPENROUTER_MAX_CONCURRENCY=30


# ── Email (app-level SMTP or Resend) ──────────────────────────────────────────
# Organization invitations are sent by Aicser directly so existing Supabase
# users can still receive invite links. Supabase Auth invite emails are not used
# for organization invites because Supabase skips users that already exist.
# Resend SMTP: SMTP_USERNAME=resend and SMTP_PASSWORD=<your Resend API key>.
# Resend API: set RESEND_API_KEY and RESEND_FROM instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=no-reply@example.com
SMTP_USE_SSL=
SMTP_USE_TLS=true
RESEND_API_KEY=
RESEND_FROM=Aicser <no-reply@example.com>


# ═══════════════════════════════════════════════════════════════════════════════
# AUTH CONFIGURATION — TWO INDEPENDENT CONCERNS
# ═══════════════════════════════════════════════════════════════════════════════
#
# There are TWO completely separate auth mechanisms. Configure them independently:
#
#   1. FORM AUTH (AUTH_PROVIDER)
#      Controls how the email/password login form authenticates users.
#      Valid values: local | supabase
#
#   2. SSO BUTTON (NEXT_PUBLIC_SSO_PROVIDER)
#      Controls the "Sign In with Organization" button on the login page.
#      Valid values: keycloak | (empty = disabled)
#      Works independently of form auth — you can have local forms + Keycloak SSO.
#
# ── Common deployment scenarios ──────────────────────────────────────────────
#
#   Public SaaS (most common):
#     AUTH_PROVIDER=local
#     NEXT_PUBLIC_SSO_PROVIDER=keycloak       ← enterprise users click SSO button
#
#   Supabase-managed auth + enterprise SSO:
#     AUTH_PROVIDER=supabase
#     NEXT_PUBLIC_SSO_PROVIDER=keycloak
#
#   No SSO, just local accounts:
#     AUTH_PROVIDER=local
#     NEXT_PUBLIC_SSO_PROVIDER=               ← leave empty to hide the SSO button
#
# ═══════════════════════════════════════════════════════════════════════════════

# ── Form Auth Provider (local | supabase) ─────────────────────────────────────
# These two variables must ALWAYS be the same value.
# AUTH_PROVIDER          → read by the backend (Python/FastAPI)
# NEXT_PUBLIC_AUTH_PROVIDER → read by the browser (Next.js requires NEXT_PUBLIC_ prefix)
AUTH_PROVIDER=local
NEXT_PUBLIC_AUTH_PROVIDER=local


# ── Option A: Local Auth (AUTH_PROVIDER=local) ────────────────────────────────
# No additional variables required.
# Users are stored in the local Postgres `users` table with bcrypt-hashed passwords.
# This is the default and works out of the box with zero extra config.


# ── Option B: Supabase Auth (AUTH_PROVIDER=supabase) ─────────────────────────
# Requires a Supabase project. Get these from: https://app.supabase.com → Settings → API
#
# NEXT_PUBLIC_SUPABASE_URL      — Your project URL (public, safe for browser)
# NEXT_PUBLIC_SUPABASE_ANON_KEY — Public anon key (safe for browser)
# SUPABASE_SERVICE_ROLE_KEY     — Secret service role key (server-side only, never expose!)
# SUPABASE_JWT_SECRET           — JWT secret (Settings → API → JWT Secret)
#
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=


# ── SSO Provider (NEXT_PUBLIC_SSO_PROVIDER=keycloak) ─────────────────────────
# Set NEXT_PUBLIC_SSO_PROVIDER=keycloak to show the "Sign In with Organization"
# button on the login page. Leave empty to disable SSO entirely.
#
# When a user clicks the SSO button:
#   1. Browser redirects to Keycloak (PKCE flow)
#   2. User logs into Keycloak with their corporate credentials
#   3. Keycloak redirects back; Aicser exchanges the token and creates a session
#
# Required variables:
#   NEXT_PUBLIC_KEYCLOAK_URL      — Browser-facing Keycloak URL (e.g. http://localhost:8080)
#   NEXT_PUBLIC_KEYCLOAK_REALM    — Realm name (default: aiser)
#   NEXT_PUBLIC_KEYCLOAK_CLIENT_ID — Public PKCE client ID (e.g. aiser-client)
#   KEYCLOAK_URL                  — Internal server URL to Keycloak (e.g. http://keycloak:8080)
#   KEYCLOAK_REALM                — Same realm name (server-side)
#   KEYCLOAK_CLIENT_ID            — Confidential backend client ID (e.g. aiser-backend)
#   KEYCLOAK_CLIENT_SECRET        — Backend client secret
#
# Quick Keycloak client setup:
#   Client `aiser-client`  → Public, Standard Flow enabled, redirect: http://localhost:3000/*
#   Client `aiser-backend` → Confidential, Service Accounts enabled
#
NEXT_PUBLIC_SSO_PROVIDER=
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=aiser
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=aiser-client
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=aiser
KEYCLOAK_CLIENT_ID=aiser-backend
KEYCLOAK_CLIENT_SECRET=
# Token checks: issuer must be this realm (exact URLs here, comma-separated, when the server and
# browsers reach Keycloak by different hosts), and azp/aud must be one of these clients.
# KEYCLOAK_ISSUER=https://sso.example.com/realms/aiser
# KEYCLOAK_ALLOWED_CLIENT_IDS=aiser-client,aiser-backend
# Groups → identity groups: add a "Group Membership" mapper (token claim name: groups) to the
# client's dedicated scope. Each sign-in mirrors the user's groups into the deployment org
# (self-host) or this org; admins then grant data sources to them or map them to a role.
# KEYCLOAK_GROUPS_ORG_ID=
# SCIM provisioning defaults to the configured SSO (Keycloak when KEYCLOAK_URL/REALM are set on
# self-host); set SCIM_USER_PROVIDER to override.


# ═══════════════════════════════════════════════════════════════════════════════
# DEV / BUILD TUNING
# ═══════════════════════════════════════════════════════════════════════════════
DEV_CLIENT_PORT=3000
DEV_SERVER_PORT=8000
DEV_POSTGRES_PORT=5432
DEV_REDIS_PORT=6379
DEV_DEBUG_PORT=5678
NODE_MAX_OLD_SPACE_SIZE=4096
CLIENT_DEV_MEM_LIMIT=6g
NEXT_DEV_TURBO=false
WATCHPACK_POLLING=false
CHOKIDAR_USEPOLLING=false
# Allow unverified JWTs in development (never set to true in production!)
ALLOW_UNVERIFIED_JWT_IN_DEV=true

NEXT_BUILD_CPUS=1
NEXT_BUILD_MAX_OLD_SPACE_SIZE=3072

# ── AI capacity & reliability ───────────────────────────────────────────────
# Concurrent LLM *calls* (one question makes several). Requests over the cap queue
# briefly (AISER_LLM_SLOT_WAIT_S) instead of failing. Health probes never count.
AISER_ORG_LLM_CONCURRENCY=40
AISER_USER_LLM_CONCURRENCY=6
AISER_LLM_SLOT_WAIT_S=8
# Fail over to another model if a stream sends no first token within this many seconds.
LLM_FIRST_TOKEN_TIMEOUT_S=10
# Forecast engine: soft budget for model competition / hard cap around the whole forecast.
FORECAST_TIME_BUDGET_S=30
FORECAST_TIMEOUT_S=75
# Warehouse cost guards: BigQuery refuses queries that would bill more than this many
# bytes (0 = no cap); Snowflake/Redshift/Postgres get server-side statement timeouts.
AISER_QUERY_MAX_BYTES_BILLED=107374182400
AISER_QUERY_TAG=aicser
# Google Sheets: reuse a local snapshot for this many seconds; serve a stale one up to
# MAX_STALE seconds old if Google is unreachable.
GOOGLE_SHEETS_SNAPSHOT_TTL_S=60
GOOGLE_SHEETS_SNAPSHOT_MAX_STALE_S=86400

# ── Decision layer (typed, confidence-gated AI decisions) ──────────────────
# off | jev (TypeSafe Jev via OpenRouter; uses OPENROUTER_API_KEY) | laya (self-hosted)
DECISION_LAYER_BACKEND=off
# Per question set: off | shadow (log next to current behaviour, change nothing) | primary
# e.g. {"front_door":"shadow","column_role":"primary"} ; "*" sets the default.
# DECISION_LAYER_MODES={"*":"shadow"}
# DECISION_THRESHOLDS={"*":0.9,"front_door.mode":0.92}
# Orgs allowed to send (PII-scrubbed) request text to the backend: "*" or comma-separated ids.
# DECISION_LAYER_ALLOWED_ORGS=*
# JEV_MODEL=typesafe/jev-1.13
# JEV_ENDPOINT=https://openrouter.ai/api/v1/systemone
# LAYA_ENDPOINT=http://laya:8080/decide
# Scripts your fine-tuned Laya checkpoint supports; others abstain (fall back to the LLM path).
# LAYA_SUPPORTED_SCRIPTS=Latin

# ── Document safety (RAG) ────────────────────────────────────────────────────
# Passages that contain instructions addressed to an AI: flag (fence + mark as quoted
# content, default) | exclude (keep out of the model's context)
AISER_RAG_INJECTION_POLICY=flag

# ── Audit → SIEM forwarding (at-least-once, ordered) ────────────────────────
# AUDIT_SIEM_URL=https://splunk.example.com:8088/services/collector/event
# AUDIT_SIEM_FORMAT=splunk_hec          # or jsonl (NDJSON for Sentinel/Elastic/any HTTP intake)
# AUDIT_SIEM_AUTH_HEADER=Splunk <hec-token>
# AUDIT_SIEM_HMAC_SECRET=               # adds X-Aicser-Signature: sha256=<hex>
# AUDIT_SIEM_ORG_IDS=                   # limit to these organizations (comma-separated)
# AUDIT_SIEM_BATCH_SIZE=500

# ── MCP server (/mcp) — AI assistants connect with a platform API key ───────
# Browser origins allowed to call /mcp besides FRONTEND_URL (desktop/CLI clients send none)
# MCP_ALLOWED_ORIGINS=

# ── AI engine: hedging, reuse, priorities ───────────────────────────────────
# LLM_HEDGE_AFTER_S=4                  # no first token after N s -> race a backup model (0 = off)
# AISER_NARRATIVE_CACHE_TTL_S=900      # reuse a narrative for identical inputs (0 = off)
# AISER_FORECAST_HOLIDAY_COUNTRY=KH   # daily forecasts learn this country's public holidays (ISO code)
# AISER_AI_RESIDENCY_DEFAULT=          # JSON policy for every org, e.g. air-gapped: see deploy/AIR_GAPPED.md
# AISER_LLM_BACKGROUND_SHARE=0.5       # max share of org AI slots for worker jobs
# AISER_LLM_BACKGROUND_WAIT_S=60
# DECISION_SURFACE_THRESHOLDS={"*":0.5} # below act threshold but above this: used, flagged for the user
# DECISION_CALIBRATION_MAX_ECE=0.10    # nightly calibration: drift above this blocks "ready for primary"
# DECISION_CALIBRATION_MIN_SAMPLES=100

# ── AI Decisions (per-row typed questions) ──────────────────────────────────
# AISER_AI_DECISIONS_MAX_ROWS=200000
# AISER_AI_DECISIONS_MAX_DISTINCT=50000
# AISER_AI_DECISIONS_CONCURRENCY=8
# JEV_PRICE_PER_M_INPUT=0.042          # for cost estimates
# AISER_AI_DECISIONS_LLM_PRICE_PER_M=  # optional: cost estimate when running on the LLM fallback

# ── SCIM provisioning (/scim/v2; tokens under Settings -> Identity) ───────────
# SCIM_USER_PROVIDER=supabase          # sign-in provider SCIM-created accounts belong to
# SCIM_DEFAULT_ROLE=org_member         # org role for provisioned users (org_viewer for read-only)

# Decide / Business OS budgets
# AISER_DECIDE_BRIEF_TIMEOUT_S=90      # Decision Brief stream budget
# AISER_DECIDE_REVISION_BUDGET_S=45    # revise the brief once only if the first draft took less than this
# AISER_JOURNEY_PHASE_TIMEOUT_S=6      # Business OS phase classification LLM cap (Jev answers first when enabled)

# ── Knowledge: sync from apps (Knowledge > Sync from apps) ──────────────────
# Set once for the whole workspace; the page shows "No apps connected yet" until one is set.
# SharePoint (Microsoft Graph, app registration with Sites.Read.All):
# SHAREPOINT_TENANT_ID=
# SHAREPOINT_CLIENT_ID=
# SHAREPOINT_CLIENT_SECRET=
# Confluence Cloud:
# CONFLUENCE_BASE_URL=https://your-company.atlassian.net/wiki
# CONFLUENCE_EMAIL=
# CONFLUENCE_API_TOKEN=

# Featurebase support portal (/support): sign users in automatically.
# Use the JWT secret from Featurebase secure installation (SSO). Unset = anonymous portal.
# FEATUREBASE_JWT_SECRET=

# ── KHQR payments via CutLuy (Cambodian banks & wallets, USD) ────────────────
# One-time payments: each KHQR purchase prepays one month/year of Pro or Team (no auto-renew).
# CutLuy dashboard setup:
#   Webhook URL:       https://<api-domain>/pricing/webhooks/cutluy   (events: payment.completed)
#   Checkout redirect: https://<app-domain>/chat   (CutLuy appends ?status=&payment_id=&reference_id=)
# CUTLUY_ENABLED=true
# CUTLUY_API_KEY=ck_live_...
# CUTLUY_WEBHOOK_SECRET=

# Other sites allowed to call this app's /api/* from a browser with the user's login
# (comma-separated origins, e.g. https://admin.example.com). Leave empty: only this app itself.
CORS_ALLOWED_ORIGINS=
