# Local-only smoke-test env for the EE self-host image compose stack.
# These values are intentionally dummy values. Do not use this file on a VPS.

AISER_SERVER_IMAGE=aiser-ee-server:self-host
AISER_CLIENT_IMAGE=aiser-ee-client:self-host

POSTGRES_DB=aiser
POSTGRES_USER=aiser
POSTGRES_PASSWORD=local-postgres-password
AISER_EDITION_LICENSE_KEY=local-smoke-license
SECRET_KEY=local-secret-key
JWT_SECRET_KEY=local-jwt-secret-key
JWT_SECRET=local-jwt-secret
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

FRONTEND_URL=http://localhost:3100
NEXT_PUBLIC_SSO_PROVIDER=
COOKIE_SECURE=false
SERVER_WORKERS=1

SELF_HOST_CLIENT_PORT_HOST=3100
SELF_HOST_SERVER_PORT_HOST=8100
SELF_HOST_POSTGRES_PORT_HOST=5435

NEXT_PUBLIC_AI_ENABLED=true
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1-mini

EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=Aicser
SMTP_USE_TLS=true
SMTP_USE_SSL=
RESEND_API_KEY=
RESEND_FROM=

STORAGE_BACKEND=
