# Aicser Enterprise self-host image runtime config.
# Copy to /opt/aiser/.env on the VPS and edit values before running:
#   docker compose --env-file .env -f docker-compose.ee.self-host.yml up -d

AISER_SERVER_IMAGE=ghcr.io/aicser-platform/aicser-server-ee:latest
AISER_CLIENT_IMAGE=ghcr.io/aicser-platform/aicser-client-ee:latest
AISER_DEPLOYMENT_MODE=self_host
AISER_EDITION_LICENSE_KEY=
LICENSE_SERVER_URL=https://license.aicser.com

FRONTEND_URL=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_EDITION=enterprise
NEXT_PUBLIC_AISER_DEPLOYMENT_MODE=self_host
NEXT_PUBLIC_AI_ENABLED=true

CLIENT_PORT_HOST=3000
SERVER_PORT_HOST=8000
POSTGRES_PORT_HOST=5432

POSTGRES_DB=aiser
POSTGRES_USER=aiser
POSTGRES_PASSWORD=

SECRET_KEY=
JWT_SECRET_KEY=
ENCRYPTION_KEY=
COOKIE_SECURE=true
ENVIRONMENT=production

AUTH_PROVIDER=local
NEXT_PUBLIC_AUTH_PROVIDER=local
NEXT_PUBLIC_SSO_PROVIDER=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1-mini

# These are env bootstrap values. Admin Settings can override them after deploy.
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_USE_TLS=true
SMTP_USE_SSL=
RESEND_API_KEY=
RESEND_FROM=

STORAGE_BACKEND=s3
S3_PROVIDER=railway
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=us-east-1
