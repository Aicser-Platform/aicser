# Copy to .env (same folder) — read by both the Node and the Python server.

# Aicser API, used server-side to sign links (FastAPI directly, or the web app, which proxies /api/embed).
AICSER_API_URL=http://localhost:8001
# Aicser web app, where the iframe loads /embed/... from.
AICSER_APP_URL=http://localhost:3001
# Settings → API keys. Server-side only: never send it to the browser.
AICSER_API_KEY=aiser_sk_replace_me

# What to embed (at least one).
AICSER_DASHBOARD_ID=
AICSER_CHART_ID=

# Optional: the AI assistant chat (Enterprise). Settings → Embed → Assistants: set the assistant's
# authentication mode to "Embed token" or "Anonymous", then "Get embed code" for the token.
# Chat can't be signed per visitor and ignores the locked filter below.
AICSER_ASSISTANT_ID=
AICSER_CHAT_TOKEN=

# Optional: pin every query to one customer's rows. The demo's "Signed in as" picker stands in
# for your app's login; the server (never the browser) turns it into the locked filter.
# The column must exist in every table the dashboard queries, or its charts fail (fail-closed).
LOCKED_FILTER_FIELD=
CUSTOMERS=acme,globex

# Optional: sites allowed to show the embed (comma-separated). Embeds only allow https:// sites,
# so leave empty when the demo runs on http://localhost.
ALLOWED_DOMAINS=
# none | image | data
DOWNLOAD=image
# Session length once opened, 5–1440. Use 5 to watch silent renewal (token-expiring → getToken).
EXPIRES_IN_MINUTES=5
