# ── Secrets & environment (never commit real credentials) ──
.env
.env.*
!.env.example
!**/.env.example
deploy/.env
deploy/.env.*

# ── Python ──
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
.eggs/
dist/
build/
*.egg
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# ── Local databases & uploads (runtime / dev artifacts) ──
*.db
*.sqlite3
*.duckdb
!scripts/sample-data/duckdb/sample_data.duckdb
uploads/
**/uploads/

# ── Node / Next.js ──
node_modules/
.next/
.next-dev/
.next.broken/
out/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Logs ──
*.log
logs/

# ── Keys & certs ──
*.pem
*.p12
*.pfx
*.key
!**/*.key.example

# ── OS ──
.DS_Store
Thumbs.db

# ── Editors & local AI tooling ──
.vscode/
.idea/
*.swp
*.swo
.cursor/
.claude/
CLAUDE.md

# ── Local / generated docs (not the repo docs/ folder) ──
/server/docs/
.superpowers/

# ── Temp / cache ──
tmp/
.cache/
*.tmp
