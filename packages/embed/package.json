{
  "name": "@aicser/embed",
  "version": "0.3.1",
  "description": "Embed Aicser dashboards, charts, reports and the AI assistant: iframe SDK with token renewal, host commands, a React wrapper and a server-side signing helper",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run --environment jsdom"
  },
  "devDependencies": {
    "@sentry/browser": "^8.55.2",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.4.0",
    "jsdom": "^26.0.0",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "@sentry/browser": "^8.0.0",
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "@sentry/browser": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aicser-Platform/aicser.git",
    "directory": "packages/embed"
  },
  "homepage": "https://github.com/Aicser-Platform/aicser/tree/main/packages/embed#readme",
  "bugs": {
    "url": "https://github.com/Aicser-Platform/aicser/issues"
  },
  "keywords": [
    "aicser",
    "embed",
    "iframe",
    "analytics",
    "dashboard",
    "react",
    "embedded-analytics"
  ],
  "engines": {
    "node": ">=18"
  }
}
