# Aiser World Environment Configuration

# Azure OpenAI Configuration (Primary)
#2024-12-01-preview #2025-04-01-preview 

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT_NAME=
#2024-12-01-preview #2025-04-01-preview
# Azure blob storage
#   credentials to connect to azure, local testing only
#   comes from 'aicser-local-blob-storage-access' service principle in azure
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
#   required in every environment
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
# OpenAI Configuration (Fallback) - Using a working key for testing
OPENAI_API_KEY=
OPENAI_MODEL_ID=
# Database Configuration (when running via docker-compose)
POSTGRES_SERVER=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=
#Cube (optional — enables Cube.js semantic layer integration)
CUBEJS_TOKEN=
AICSER_EXTERNAL_CUBE_ENABLED=false
# Redis / Background Worker
REDIS_URL=
# ARQ worker: run with:  python -m arq src.shared.jobs.worker.WorkerSettings
# Required for: alert rule evaluation, scheduled reports, BI sync jobs

# ── BI Sync (EE — Power BI) ────────────────────────────────────────────────
# Register an Azure AD app: https://portal.azure.com → App registrations
# Grant: Power BI Service → Dataset.ReadWrite.All, Report.ReadWrite.All
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_TENANT_ID=
# Optional — leave blank to use the first workspace in the account
POWERBI_WORKSPACE_ID=

# ── BI Sync (EE — Tableau) ────────────────────────────────────────────────
# Create a Personal Access Token in Tableau Server / Tableau Cloud
TABLEAU_SERVER_URL=
TABLEAU_TOKEN_NAME=
TABLEAU_TOKEN_SECRET=
# Leave blank for Tableau Cloud (default site)
TABLEAU_SITE_ID=
# Security
SECRET_KEY=
JWT_ALGORITHM=
JWT_EXP_TIME_MINUTES=
# JWT_SECRET: from Supabase Dashboard → Project Settings → API → JWT Secret (enables
# token verification; avoids JWKS "no keys")
JWT_SECRET=
JWT_SECRET_KEY=
# Set true only when serving over HTTPS (production). Default false for local HTTP/Docker.
COOKIE_SECURE=
# ENCRYPTION_KEY: generate with python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Next.js dev client (docker-compose.dev.yml — client-ce / client-ee)
# Node heap MB; Next.js restarts `next dev` when usage exceeds ~80% of this value.
NODE_MAX_OLD_SPACE_SIZE=2560
# NEXT_DEV_CPUS=2
# Optional Docker memory cap for dev client containers (default 4g in compose)
# CLIENT_DEV_MEM_LIMIT=4g
# NEXT_DEV_TURBO=false

# Application URLs (use 
