# Aicser Community Edition local Docker settings.
# Copy to .env before running:
#   docker compose -f docker-compose.ce.yml up -d

AISER_VERSION=latest

# Host ports
CLIENT_PORT=3000
SERVER_PORT=8000
POSTGRES_PORT_HOST=5432

# Database
POSTGRES_DB=aicser
POSTGRES_USER=aicser
POSTGRES_PASSWORD=aicser_password

# Security
# For a shared or internet-facing deployment, replace these with strong random values.
SECRET_KEY=change-me-local-secret
JWT_SECRET=change-me-local-jwt-secret
JWT_SECRET_KEY=change-me-local-jwt-secret
ENCRYPTION_KEY=
COOKIE_SECURE=false

# Browser/API URLs for local Docker.
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AI_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional runtime config bootstrap.
# These env values are used until an admin saves overrides in Settings > Integrations.

# Schema visibility (EE AI / NL2SQL): <N tables → full catalog; ≥N → Schema RAG / subset.
# Defaults match WorkflowConfig (SCHEMA_RAG_TABLE_THRESHOLD / TWO_PASS = 15).
# SCHEMA_RAG_TABLE_THRESHOLD=15
# AISER_SCHEMA_FULL_CATALOG_MAX=15
# AISER_TWO_PASS_TABLE_THRESHOLD=15
# USE_SCHEMA_RAG=true
# SCHEMA_RAG_TOP_K_TABLES=18

EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_USE_TLS=true
SMTP_USE_SSL=
RESEND_API_KEY=
RESEND_FROM=

STORAGE_BACKEND=
# Empty = auto-detect: S3 credentials → s3; Azure URL+container → azure_blob; else postgresql (local Docker).
# Set explicitly for production: s3 | azure_blob | postgresql
S3_PROVIDER=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=us-east-1
