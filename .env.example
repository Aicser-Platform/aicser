# Aicser Community Edition local Docker settings.
# Copy to .env before running:
#   docker compose -f docker-compose.ce.yml up -d

AISER_VERSION=latest

# Host ports
CLIENT_PORT=3000
SERVER_PORT=8000
POSTGRES_PORT_HOST=5432

# Database
POSTGRES_DB=aicser
POSTGRES_USER=aicser
POSTGRES_PASSWORD=aicser_password

# Security
# For a shared or internet-facing deployment, replace these with strong random values.
SECRET_KEY=change-me-local-secret
JWT_SECRET=change-me-local-jwt-secret
JWT_SECRET_KEY=change-me-local-jwt-secret
ENCRYPTION_KEY=
COOKIE_SECURE=false

# Browser/API URLs for local Docker.
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AI_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional runtime config bootstrap.
# These env values are used until an admin saves overrides in Settings > Integrations.

# Schema visibility (EE AI / NL2SQL): <N tables → full catalog; ≥N → Schema RAG / subset.
# Defaults match WorkflowConfig (SCHEMA_RAG_TABLE_THRESHOLD / TWO_PASS = 15).
# SCHEMA_RAG_TABLE_THRESHOLD=15
# AISER_SCHEMA_FULL_CATALOG_MAX=15
# AISER_TWO_PASS_TABLE_THRESHOLD=15
# USE_SCHEMA_RAG=true
# SCHEMA_RAG_TOP_K_TABLES=18

EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_USE_TLS=true
SMTP_USE_SSL=
RESEND_API_KEY=
RESEND_FROM=

STORAGE_BACKEND=
# Empty = auto-detect: S3 credentials → s3; Azure URL+container → azure_blob; else postgresql (local Docker).
# Set explicitly for production: s3 | azure_blob | postgresql
S3_PROVIDER=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=us-east-1

# ---------------------------------------------------------------------------
# Location analysis (all editions)
# ---------------------------------------------------------------------------
# Road network for drive, walk and bike times (Valhalla on OpenStreetMap; © OpenStreetMap
# contributors, ODbL). Comma-separate several Geofabrik extracts to cover your region.
ROUTING_OSM_PBF_URL=https://download.geofabrik.de/asia/cambodia-latest.osm.pbf
ROUTING_THREADS=4
# ROUTING_URL=http://routing:8002
# Street basemap tiles (MapLibre style URLs). Defaults: OpenFreeMap (OpenStreetMap data).
# NEXT_PUBLIC_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# NEXT_PUBLIC_BASEMAP_STYLE_URL_DARK=https://tiles.openfreemap.org/styles/dark
# SPATIAL_MAX_POINTS=200000
# SPATIAL_MAX_DRIVE_POINTS=5000

# ---------------------------------------------------------------------------
# Notebooks (all editions): Python runs in the browser (Pyodide). Self-host it for
# air-gapped installs by pointing at a folder containing pyodide.js.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_PYODIDE_URL=https://cdn.jsdelivr.net/pyodide/v0.28.3/full/

# ---------------------------------------------------------------------------
# Warehouse (Enterprise): serving layer over the lakehouse's Gold tables
# ---------------------------------------------------------------------------
# Shared secret between the app server and the warehouse compute pool (required for "pool").
WAREHOUSE_COMPUTE_TOKEN=
WAREHOUSE_COMPUTE_REPLICAS=2
WAREHOUSE_NODE_CPUS=2
WAREHOUSE_NODE_MEMORY=4g

# --- Scheduled notebook runs (Enterprise; the notebook-runner service) ---
# A long random key shared by the server and the runner (e.g. `openssl rand -base64 36`).
# Leave empty to keep scheduling off. The runner has no other secrets and no internet access.
NOTEBOOK_RUNNER_KEY=
# NOTEBOOK_RUNNER_MEMORY=3g
# Distributed engine (start with --profile trino), e.g. http://trino:8080
TRINO_URL=
# LAKEHOUSE_LOCAL_ROOT=/app/uploads/lake
# "auto" warehouses route each query by the size of the tables it reads: below this many GB it
# runs embedded (DuckDB), up to the Trino threshold on the compute pool, above it on Trino.
# WAREHOUSE_AUTO_POOL_GB=2
# WAREHOUSE_AUTO_TRINO_GB=50
# Outside engines (Spark, Trino, DuckDB, PyIceberg) can read Gold tables through the read-only
# Iceberg REST catalog at <server>/api/warehouse/iceberg with an org admin's API key. They read
# files directly (outside row security), so data must be in object storage they can reach.

# ---------------------------------------------------------------------------
# Models (Enterprise)
# ---------------------------------------------------------------------------
# ML_MODEL_DIR=/app/uploads/models
# ML_MAX_TRAIN_ROWS=300000

# Anonymous embed viewers get at most this many rows per chart.
# EMBED_MAX_ROWS=2000
