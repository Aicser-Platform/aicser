# Aicser Community Edition (CE) Docker environment
#
# Quick start:
#   cp .env.example .env
#   make -C deploy ce
#
# The compose files in deploy/ read ../.env because deploy/.env is a symlink
# to the repository root .env file.

# ── Edition ──────────────────────────────────────────────────────────────────
AISER_EDITION=community
AISER_EDITION_LICENSE_KEY=

# ── Browser URLs ─────────────────────────────────────────────────────────────
# Must be reachable from your browser.
# Local Docker Desktop / local Linux:
NEXT_PUBLIC_API_URL=http://localhost:8000

# If running on a remote Linux host, use the host URL instead, for example:
# NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP:8000

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=db_name
POSTGRES_USER=db_user
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

# ── Security ─────────────────────────────────────────────────────────────────
# Generate strong values before shared or production use.
# SECRET_KEY:
#   openssl rand -hex 32
# JWT_SECRET_KEY:
#   openssl rand -base64 64
# ENCRYPTION_KEY:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-base64-64
JWT_SECRET=
JWT_ALGORITHM=HS256
COOKIE_SECURE=false
ENCRYPTION_KEY=

# ── Runtime ──────────────────────────────────────────────────────────────────
ENVIRONMENT=production
REDIS_URL=redis://redis:6379
MAX_FILE_SIZE_MB=300

# CE stores uploaded datasource files and feed thumbnails locally/PostgreSQL.
# Leave S3/Azure storage blank for normal CE.
STORAGE_BACKEND=postgresql

# ── Optional AI Providers ────────────────────────────────────────────────────
# Leave blank if you do not need AI features.


# ── Optional Email ───────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=Aicser

# ── CE Development Stack Overrides ───────────────────────────────────────────
# Used by:
#   make -C deploy dev-ce
DEV_CLIENT_PORT=3000
DEV_SERVER_PORT=8000
DEV_POSTGRES_PORT=5432
DEV_REDIS_PORT=6379
DEV_DEBUG_PORT=5678
NODE_MAX_OLD_SPACE_SIZE=4096
CLIENT_DEV_MEM_LIMIT=6g
NEXT_DEV_TURBO=false
WATCHPACK_POLLING=false
CHOKIDAR_USEPOLLING=false
ALLOW_UNVERIFIED_JWT_IN_DEV=true

# ── CE Production Build Tuning ───────────────────────────────────────────────
# Useful on Docker Desktop / lower-memory machines.
NEXT_BUILD_CPUS=1
NEXT_BUILD_MAX_OLD_SPACE_SIZE=3072
