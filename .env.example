# Aicser Community Edition local Docker settings.
# Copy to .env before running:
#   docker compose -f docker-compose.ce.yml up -d

AISER_VERSION=latest

# Host ports
CLIENT_PORT=3000
SERVER_PORT=8000
POSTGRES_PORT_HOST=5432

# Database
POSTGRES_DB=aicser
POSTGRES_USER=aicser
POSTGRES_PASSWORD=aicser_password

# Security
# For a shared or internet-facing deployment, replace these with strong random values.
SECRET_KEY=change-me-local-secret
JWT_SECRET=change-me-local-jwt-secret
JWT_SECRET_KEY=change-me-local-jwt-secret
ENCRYPTION_KEY=
COOKIE_SECURE=false

# Browser/API URLs for local Docker.
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
