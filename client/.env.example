# Next.js client (local or Docker). For full-stack dev, prefer repo root `.env` + docker-compose.dev.yml.
# Copy to `.env.local` for local `npm run dev` (Next.js loads .env.local automatically).

# Browser-visible API base (same host as your machine when testing from browser)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Used by server-side rewrites / Route Handlers — in Docker dev this is set to http://chat2chart-server:8000
# API_TARGET=http://chat2chart-server:8000

NEXT_PUBLIC_APP_URL=http://localhost:3000

# CE local dev: FastAPI JWT via /api/auth/* — httpOnly auth_token + same JWT in JSON access_token for Authorization: Bearer (sessionStorage). Leave Supabase unset.
# Optional: Supabase client (only if you use Supabase-hosted auth in the browser)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set true only when API calls must send Supabase Bearer; community edition ignores Supabase for fetchApi unless this is true
# NEXT_PUBLIC_USE_SUPABASE_AUTH=false

# Optional: separate auth service (not started by docker-compose.dev.yml)
# NEXT_PUBLIC_AUTH_URL=http://localhost:5000

# Optional: Cube.js when running semantic layer separately
# NEXT_PUBLIC_CUBEJS_URL=http://localhost:4000
# NEXT_PUBLIC_CUBEJS_TOKEN=

# Edition: community (default) or enterprise
NEXT_PUBLIC_EDITION=community
