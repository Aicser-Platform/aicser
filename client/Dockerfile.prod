FROM node:20.19-alpine AS base

# Install dependencies only when needed
FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Install dependencies based on the preferred package manager
COPY package.json package-lock.json* ./
COPY scripts ./scripts
RUN npm ci --no-audit --no-fund --fetch-retries=5 --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=120000


# Rebuild the source code only when needed
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Accept EDITION build arg — 'community' (default) or 'enterprise'
ARG EDITION=community
ENV EDITION=$EDITION

# Accept build arguments for NEXT_PUBLIC_* variables
ARG NEXT_PUBLIC_AUTH_PROVIDER
ARG NEXT_PUBLIC_KEYCLOAK_URL
ARG NEXT_PUBLIC_KEYCLOAK_REALM
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_EDITION=community
ARG NEXT_PUBLIC_AISER_DEPLOYMENT_MODE
ARG AISER_VERSION=1.1.1
ARG NEXT_PUBLIC_AISER_VERSION=1.1.1
ARG NEXT_PUBLIC_AI_ENABLED=true
ARG NEXT_PUBLIC_SSO_PROVIDER
ARG NEXT_PUBLIC_KEYCLOAK_URL
ARG NEXT_PUBLIC_KEYCLOAK_REALM
ARG NEXT_PUBLIC_KEYCLOAK_CLIENT_ID
ARG NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
ARG NEXT_BUILD_CPUS=1
ARG NEXT_BUILD_MAX_OLD_SPACE_SIZE=3072

# Set them as environment variables for the build
ENV NEXT_PUBLIC_AUTH_PROVIDER=$NEXT_PUBLIC_AUTH_PROVIDER
ENV NEXT_PUBLIC_KEYCLOAK_URL=$NEXT_PUBLIC_KEYCLOAK_URL
ENV NEXT_PUBLIC_KEYCLOAK_REALM=$NEXT_PUBLIC_KEYCLOAK_REALM
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_EDITION=$NEXT_PUBLIC_EDITION
ENV NEXT_PUBLIC_AISER_DEPLOYMENT_MODE=$NEXT_PUBLIC_AISER_DEPLOYMENT_MODE
ENV AISER_VERSION=$AISER_VERSION
ENV NEXT_PUBLIC_AISER_VERSION=$NEXT_PUBLIC_AISER_VERSION
ENV NEXT_PUBLIC_AI_ENABLED=$NEXT_PUBLIC_AI_ENABLED
ENV NEXT_PUBLIC_SSO_PROVIDER=$NEXT_PUBLIC_SSO_PROVIDER
ENV NEXT_PUBLIC_KEYCLOAK_URL=$NEXT_PUBLIC_KEYCLOAK_URL
ENV NEXT_PUBLIC_KEYCLOAK_REALM=$NEXT_PUBLIC_KEYCLOAK_REALM
ENV NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=$NEXT_PUBLIC_KEYCLOAK_CLIENT_ID
ENV NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=$NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_DEV_CPUS=$NEXT_BUILD_CPUS

RUN node scripts/setup-ee.js
# Next 16 defaults to Turbopack for `next build`. This app still needs webpack
# (custom aliases, Serwist, CSS @import + Tailwind order). Match package.json.
RUN node scripts/generate-pwa-icons.mjs \
  && NODE_OPTIONS="--max-old-space-size=${NEXT_BUILD_MAX_OLD_SPACE_SIZE} --max-semi-space-size=64 --expose-gc" ./node_modules/.bin/next build --webpack
# PWA: Serwist emits public/sw.js during next build — fail fast if missing
RUN test -f public/sw.js

# Production image, copy all the files and run next
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ARG AISER_VERSION=1.1.1
ARG NEXT_PUBLIC_AISER_VERSION=1.1.1
ENV AISER_VERSION=$AISER_VERSION
ENV NEXT_PUBLIC_AISER_VERSION=$NEXT_PUBLIC_AISER_VERSION

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

ENV PORT=3000

ENV HOSTNAME="0.0.0.0"
CMD ["node", "server.js"]
