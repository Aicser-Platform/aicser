FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache netcat-openbsd curl

COPY package*.json ./
COPY scripts ./scripts
RUN npm install --no-audit --no-fund

ARG EDITION=community
ENV EDITION=${EDITION}
ENV NEXT_PUBLIC_EDITION=${EDITION}
ENV NEXT_TELEMETRY_DISABLED=1
ENV WATCHPACK_POLLING=false
ENV CHOKIDAR_USEPOLLING=false
ENV NEXT_DEV_TURBO=false
ENV NODE_MAX_OLD_SPACE_SIZE=2048

# Source code is mounted via docker-compose volume (../client:/app).
# node_modules is preserved by a named volume so the npm install above
# initialises it only on the first run; no COPY . . needed.
# setup-ee.js generates src/ee/index.ts so @/ee resolves for both webpack and Turbopack.
CMD ["sh", "-c", "export NEXT_PUBLIC_EDITION=\"${NEXT_PUBLIC_EDITION:-$EDITION}\"; node scripts/setup-ee.js && if [ \"${NEXT_DEV_TURBO}\" = \"true\" ]; then npm run dev:turbo -- -H 0.0.0.0 -p ${PORT:-3000}; else NODE_OPTIONS=\"--max-old-space-size=${NODE_MAX_OLD_SPACE_SIZE:-2048}\" ./node_modules/.bin/next dev -H 0.0.0.0 -p ${PORT:-3000}; fi"]
