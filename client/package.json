{
  "name": "aicser-client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/setup-ee.js && node scripts/generate-pwa-icons.mjs",
    "prebuild": "node scripts/generate-pwa-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' next dev",
    "dev:light": "NODE_OPTIONS='--max-old-space-size=3072' next dev",
    "dev:turbo": "NODE_OPTIONS='--max-old-space-size=4096' next dev --turbo",
    "build": "NODE_OPTIONS='--max-old-space-size=1536' next build",
    "build:light": "NODE_OPTIONS='--max-old-space-size=1024' next build",
    "start:prod": "next start",
    "preview:pwa": "NEXT_PUBLIC_PWA_DEV=true npm run build && NEXT_PUBLIC_PWA_DEV=true next start",
    "start": "next start",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint .",
    "lint:css": "stylelint \"src/**/*.css\" \"ee/**/*.css\" --allow-empty-input && node scripts/check-css-balance.mjs && node scripts/check-css-ownership.mjs",
    "format": "prettier --write .",
    "clean": "rm -rf .next"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/nextjs-registry": "^1.0.2",
    "@duckdb/duckdb-wasm": "^1.29.1-dev132.0",
    "@marp-team/marp-cli": "^4.2.3",
    "@monaco-editor/react": "^4.7.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.2",
    "@opentelemetry/instrumentation": "^0.57.2",
    "@opentelemetry/instrumentation-fetch": "^0.57.2",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "@opentelemetry/sdk-trace-web": "^1.30.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@sentry/nextjs": "^8.55.2",
    "@serwist/next": "^9.5.11",
    "@stripe/react-stripe-js": "^6.4.0",
    "@stripe/stripe-js": "^9.6.0",
    "@supabase/supabase-js": "^2.89.0",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/lodash": "^4.17.20",
    "@types/lodash-es": "^4.17.12",
    "@types/react-grid-layout": "^1.3.5",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/shortid": "^2.2.0",
    "ace-builds": "^1.37.4",
    "antd": "^5.29.3",
    "axios": "^1.11.0",
    "dayjs": "^1.11.13",
    "echarts": "^6.0.0",
    "es-abstract": "^1.22.0",
    "fabric": "^6.7.1",
    "formdata-polyfill": "^4.0.10",
    "formidable": "^3.5.4",
    "highlight.js": "^11.11.1",
    "html2canvas": "^1.4.1",
    "immer": "^10.1.1",
    "js-cookie": "^3.0.5",
    "jspdf": "4.0.0",
    "less": "^4.2.1",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "next": "14.2.35",
    "next-intl": "^4.9.0",
    "node-fetch": "^3.3.2",
    "react": "^18",
    "react-ace": "^13.0.0",
    "react-dom": "^18",
    "react-grid-layout": "^1.5.2",
    "react-hotkeys-hook": "^5.1.0",
    "react-markdown": "^9.1.0",
    "react-rnd": "^10.5.2",
    "react-syntax-highlighter": "^16.1.0",
    "recharts": "^2.15.4",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "serwist": "^9.5.11",
    "shallow": "^1.0.0",
    "sharp": "^0.33.5",
    "shortid": "^2.2.16",
    "socket.io-client": "^4.8.1",
    "xlsx": "^0.18.5",
    "zundo": "^2.3.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "20.19.11",
    "@types/react": "18.3.24",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.4.21",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "eslint-config-prettier": "^10.0.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "prettier": "^3.4.2",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^36.0.1",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      "glob": "^10.5.0"
    }
  }
}
