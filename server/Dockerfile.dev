FROM python:3.11-slim-bookworm

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    AISER_EDITION=community \
    ENVIRONMENT=development \
    DEBUG=true \
    WATCHFILES_FORCE_POLLING=true

ARG ODBC18_DEB_AMD64=https://packages.microsoft.com/debian/12/prod/pool/main/m/msodbcsql18/msodbcsql18_18.6.1.1-1_amd64.deb
ARG ODBC18_DEB_ARM64=https://packages.microsoft.com/debian/12/prod/pool/main/m/msodbcsql18/msodbcsql18_18.6.1.1-1_arm64.deb

# Install system dependencies + Microsoft ODBC Driver 18 via direct .deb
# instead of adding packages.microsoft.com as an apt repository.
RUN set -eux; \
    rm -rf /var/lib/apt/lists/*; \
    apt-get -o Acquire::Retries=5 update; \
    apt-get install -y --no-install-recommends \
      build-essential \
      libpq-dev \
      libsnappy-dev \
      unixodbc-dev \
      ca-certificates \
      curl \
      netcat-openbsd \
      wget \
      libgssapi-krb5-2; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) url="${ODBC18_DEB_AMD64}" ;; \
      arm64) url="${ODBC18_DEB_ARM64}" ;; \
      *) echo "Unsupported architecture for msodbcsql18: $arch"; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/msodbcsql18.deb "$url"; \
    echo "msodbcsql18 msodbcsql/ACCEPT_EULA boolean true" | debconf-set-selections; \
    DEBIAN_FRONTEND=noninteractive dpkg -i /tmp/msodbcsql18.deb || apt-get install -y -f --no-install-recommends; \
    rm -f /tmp/msodbcsql18.deb; \
    rm -rf /var/lib/apt/lists/*

# Create virtualenv and install dependencies
RUN python -m venv /venv
ENV PATH="/venv/bin:$PATH"


COPY requirements.txt ./
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip setuptools wheel \
    && pip install -r requirements.txt

# Fail the image build if Telegram deps are missing (avoids uvicorn crash at import time)
RUN python -c "import telegram.ext; print('python-telegram-bot OK')"
RUN python -c "import fastapi_mail; print('fastapi-mail OK')"

# Verify key dependencies
RUN python -c "import duckdb; print('DuckDB OK')" || (echo 'ERROR: DuckDB import failed' && exit 1)
RUN python -c "import sqlglot; print('sqlglot OK')" || (echo 'ERROR: sqlglot import failed' && exit 1)
RUN python -c "import prophet; print('prophet OK')" || (echo 'ERROR: prophet import failed' && exit 1)
RUN python -c "import pmdarima; print('pmdarima OK')" || (echo 'ERROR: pmdarima import failed' && exit 1)
RUN python -c "import statsmodels; print('statsmodels OK')" || (echo 'ERROR: statsmodels import failed' && exit 1)
# Install playwright Python package + Chromium browser.
# System deps (--with-deps) require apt GPG verification which can fail in
# restricted build environments; fall back to browserless install so the server
# still starts. Chart/dashboard screenshot exports will fail at runtime if
# system libs are missing, but all other routes work normally.
RUN pip install playwright && \
    (python -m playwright install chromium --with-deps 2>&1 || \
     python -m playwright install chromium 2>&1 || \
     echo "Playwright browser install skipped (non-fatal in dev)")
# Copy the Alembic configuration and migrations
COPY alembic.ini /app/alembic.ini
COPY alembic /app/alembic

COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Copy application code
COPY src ./src

# Generate the sample DuckDB file with this image's pinned duckdb version.
# In local dev-via-compose this gets shadowed by the source bind mount, so
# the compose entrypoint also runs `sample_data.ensure` at container start.
RUN python -m src.shared.sample_data.ensure

# Remove __pycache__ directories to ensure clean imports
RUN find . -type d -name "__pycache__" -exec rm -r {} +


EXPOSE 8000
EXPOSE 5678

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["/venv/bin/python", "-m", "uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--log-level", "debug"]
