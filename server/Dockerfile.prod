# =========================
# Builder Stage
# =========================
FROM python:3.11-slim-bookworm AS builder

WORKDIR /app

ARG ODBC18_DEB_AMD64=https://packages.microsoft.com/debian/12/prod/pool/main/m/msodbcsql18/msodbcsql18_18.6.1.1-1_amd64.deb
ARG ODBC18_DEB_ARM64=https://packages.microsoft.com/debian/12/prod/pool/main/m/msodbcsql18/msodbcsql18_18.6.1.1-1_arm64.deb

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Install build dependencies + Microsoft ODBC driver.
# Use the direct driver package to avoid adding the Microsoft apt repository in
# Docker builds, which is more fragile in restricted/network-cached environments.
RUN set -eux; \
    rm -rf /var/lib/apt/lists/*; \
    apt-get -o Acquire::Retries=5 update; \
    apt-get install -y --no-install-recommends \
      build-essential \
      libpq-dev \
      libsnappy-dev \
      unixodbc-dev \
      ca-certificates \
      curl \
      libgssapi-krb5-2; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) url="${ODBC18_DEB_AMD64}" ;; \
      arm64) url="${ODBC18_DEB_ARM64}" ;; \
      *) echo "Unsupported architecture for msodbcsql18: $arch"; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/msodbcsql18.deb "$url"; \
    echo "msodbcsql18 msodbcsql/ACCEPT_EULA boolean true" | debconf-set-selections; \
    DEBIAN_FRONTEND=noninteractive dpkg -i /tmp/msodbcsql18.deb || apt-get install -y -f --no-install-recommends; \
    rm -f /tmp/msodbcsql18.deb; \
    rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python -m venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"

# Install Python dependencies
COPY requirements.txt .

# Install Python dependencies + Playwright browser binaries used for
# chart/dashboard PNG export. Browser system libraries belong in the runner
# stage; installing them here only inflates the build cache because this stage
# copies out the venv and Playwright cache, not apt-installed packages.
RUN pip install --upgrade pip setuptools wheel \
 && pip install --no-cache-dir -r requirements.txt \
 && pip install --no-cache-dir 'playwright>=1.40.0' \
 && python -c "import telegram.ext; print('python-telegram-bot OK')" \
 && python -c "import playwright; print('playwright OK')" \
 && python -m playwright install chromium \
 # en_core_web_md, not the ~590MB _lg -- see pii_scrubber.py's NlpEngineProvider
 # config, which now explicitly requests this exact model name.
 && python -m spacy download en_core_web_md \
 # presidio-anonymizer pins cryptography<49, conflicting with this image's
 # cryptography==50.0.0 (requirements.txt). --no-deps sidesteps the resolver
 # conflict entirely: the only place in presidio-anonymizer that actually
 # imports cryptography is its optional AES-encryption operator, which
 # src/modules/data/services/pii_scrubber.py never uses (entity detection +
 # replace-style anonymization only). Its other real dependencies are already
 # satisfied by presidio-analyzer's own requirements, installed above.
 && pip install --no-cache-dir --no-deps presidio-anonymizer==2.2.360 \
 && python -c "import presidio_analyzer, presidio_anonymizer; print('presidio OK')" \
 && find /app/.venv -name "*.pyc" -delete \
 && find /app/.venv -name "__pycache__" -type d -exec rm -rf {} +

# =========================
# Runtime Stage
# =========================
FROM python:3.11-slim-bookworm AS runner

WORKDIR /app

ARG AISER_VERSION=1.1.1
ARG ODBC18_DEB_AMD64=https://packages.microsoft.com/debian/12/prod/pool/main/m/msodbcsql18/msodbcsql18_18.6.1.1-1_amd64.deb
ARG ODBC18_DEB_ARM64=https://packages.microsoft.com/debian/12/prod/pool/main/m/msodbcsql18/msodbcsql18_18.6.1.1-1_arm64.deb
# 'community' or 'enterprise'. CE checkouts normally never have ee/ checked
# out at all (it's a separate git submodule), so this is a no-op for the
# common case -- it exists as a structural safeguard for the one path where
# it would otherwise matter: building the CE-tagged image from a full
# checkout that happens to have the ee/ submodule initialized. Runtime
# behavior is already license-gated via is_ee_enabled() regardless; this
# just stops the source from shipping in the CE image at all.
ARG EDITION=enterprise

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PATH="/app/.venv/bin:$PATH" \
    AISER_VERSION=$AISER_VERSION \
    APP_VERSION=$AISER_VERSION

# Install runtime dependencies + Microsoft ODBC + Chromium system libs.
#
# The libX*/libatk/libgbm packages below only get Chromium to LAUNCH -- they
# say nothing about whether it can actually paint text. Root-caused live: this
# stage previously installed zero font packages and no `fontconfig`, so
# `fc-list` didn't even exist in the image. Chromium on Linux routes glyph
# rasterization through Fontconfig/FreeType regardless of font source (system
# font or a downloaded @font-face webfont) -- with no fontconfig and nothing
# in /usr/share/fonts, every computed style still reports normally
# (visibility: visible, a real dark color, document.fonts.status: "loaded")
# because that's the DOM/CSSOM layer, which has no idea the paint step
# silently produced zero glyphs. Result: Playwright-rendered PDF/PNG exports
# came back with visible borders/backgrounds/icons/chart lines (all vector
# graphics, unaffected) but completely blank text everywhere a font would
# have to be rasterized -- while the same content in a real browser (which
# ships its own fonts) looked fine, making this invisible in every check
# short of actually rendering an export and looking at it.
RUN set -eux; \
    rm -rf /var/lib/apt/lists/*; \
    apt-get -o Acquire::Retries=5 update; \
    apt-get install -y --no-install-recommends \
      libpq5 \
      libsnappy1v5 \
      unixodbc \
      ca-certificates \
      curl \
      libgssapi-krb5-2 \
      libnss3 \
      libatk1.0-0 \
      libatk-bridge2.0-0 \
      libcups2 \
      libxkbcommon0 \
      libxcomposite1 \
      libxdamage1 \
      libxfixes3 \
      libxrandr2 \
      libgbm1 \
      libasound2 \
      fontconfig \
      fonts-liberation \
      fonts-noto-color-emoji \
      fonts-freefont-ttf; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) url="${ODBC18_DEB_AMD64}" ;; \
      arm64) url="${ODBC18_DEB_ARM64}" ;; \
      *) echo "Unsupported architecture for msodbcsql18: $arch"; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/msodbcsql18.deb "$url"; \
    echo "msodbcsql18 msodbcsql/ACCEPT_EULA boolean true" | debconf-set-selections; \
    DEBIAN_FRONTEND=noninteractive dpkg -i /tmp/msodbcsql18.deb || apt-get install -y -f --no-install-recommends; \
    rm -f /tmp/msodbcsql18.deb; \
    rm -rf /var/lib/apt/lists/*

# Copy installed Python environment and Playwright browsers
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /root/.cache/ms-playwright /root/.cache/ms-playwright

# Copy application files. Use a single context copy so CE-only checkouts that
# do not include optional ee/ or scripts/ directories still build.
COPY . .
RUN mkdir -p ee scripts
RUN if [ "$EDITION" = "community" ] || [ "$EDITION" = "ce" ]; then \
      echo "EDITION=$EDITION -- stripping ee/ from the CE image"; \
      rm -rf ee && mkdir -p ee; \
    fi

# Generate the sample DuckDB file with this image's pinned duckdb version,
# so it can never drift out of sync with the runtime that reads it.
RUN python -m src.shared.sample_data.ensure

# Remove Python cache
RUN find . -name "__pycache__" -type d -exec rm -rf {} + || true
RUN chmod +x /app/scripts/railway-start.sh /app/scripts/railway-worker-start.sh 2>/dev/null || chmod +x /app/scripts/*.sh

EXPOSE 8000

CMD ["/app/scripts/railway-start.sh"]
